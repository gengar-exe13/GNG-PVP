local function drawPixels(parent, rows, color, ox, oy)
	ox, oy = ox or 0, oy or 0
	local parts = {}
	for y, row in ipairs(rows) do
		local x = 1
		while x <= #row do
			if row:sub(x, x) == "#" then
				local x2 = x
				while x2 < #row and row:sub(x2 + 1, x2 + 1) == "#" do x2 = x2 + 1 end
				table.insert(parts, new("Frame", {
					BackgroundColor3 = color, BorderSizePixel = 0, Position = UDim2.new(0, x - 1 + ox, 0, y - 1 + oy),
					Size = UDim2.new(0, x2 - x + 1, 0, 1), Parent = parent,
				}))
				x = x2 + 1
			else
				x = x + 1
			end
		end
	end
	return parts
end
local function makeIcon(parent, spec)
	if typeof(spec) ~= "string" then return nil end
	local rows = Icons[IconAliases[spec:lower()] or spec:lower()]
	if not rows then return nil end
	local box = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.new(0, 11, 0, 11), Parent = parent,
	})
	local w = 0
	for _, r in ipairs(rows) do w = math.max(w, #r) end
	local parts = drawPixels(box, rows, Theme.Text, math.floor((11 - w) / 2), math.floor((11 - #rows) / 2))
	return { box = box, paint = function(color) for _, p in ipairs(parts) do p.BackgroundColor3 = color end end }
end
