local __ROUNDABLE = { Frame = true, TextButton = true, TextBox = true }
local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	local hasCorner = false
	for _, c in ipairs(children or {}) do
		c.Parent = inst
		if c.ClassName == "UICorner" then hasCorner = true end
	end
	if __ROUNDABLE[class] and not hasCorner then
		pcall(function()
			if inst.BackgroundTransparency >= 1 then return end
			local w, h = inst.Size.X.Offset, inst.Size.Y.Offset
			local m = math.huge
			if inst.Size.X.Scale == 0 then m = math.min(m, w) end
			if inst.Size.Y.Scale == 0 then m = math.min(m, h) end
			if m < 6 then return end
			local r = m == math.huge and 6 or math.max(3, math.min(8, math.floor(m / 3)))
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, r)
			c.Parent = inst
		end)
	end
	return inst
end
