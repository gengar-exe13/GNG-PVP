do
    local FH = { gen = 0, on = false, range = 80, players = true, delay = 1 / 30, max = 60,
                 CombatUtil = nil, RegHit = nil, RegAtk = nil }
    local VALID = {
        RightUpperArm = true, RightLowerArm = true, RightHand = true,
        RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
        LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
        LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
        UpperTorso = true, LowerTorso = true, Head = true,
    }
    local function resolve()
        if FH.CombatUtil and FH.RegHit and FH.RegAtk and FH.RegAtk.Parent then return true end
        local Modules = ReplicatedStorage:FindFirstChild("Modules")
        local netM = Modules and Modules:FindFirstChild("Net")
        local cuM  = Modules and Modules:FindFirstChild("CombatUtil")
        if not (netM and cuM) then return false end
        local okC, CU  = pcall(require, cuM)
        local okN, Net = pcall(require, netM)
        if not (okC and okN) then return false end
        FH.CombatUtil = CU
        FH.RegAtk = netM:FindFirstChild("RE/RegisterAttack")
        local okR, re = pcall(function() return Net:RemoteEvent("RegisterHit", true) end)
        FH.RegHit = okR and re or netM:FindFirstChild("RE/RegisterHit")
        return FH.RegAtk ~= nil and FH.RegHit ~= nil
    end
    local hitOf = setmetatable({}, { __mode = "k" })
    local PlayerCache = { list = {}, at = 0 }
    local function GetPlayerCache()
        local now = os.clock()
        if now - PlayerCache.at >= 0.15 then
            PlayerCache.at = now
            local list, n = {}, 0
            local chars = workspace:FindFirstChild("Characters")
            if chars then
                for _, v in ipairs(chars:GetChildren()) do
                    local hrp = v:FindFirstChild("HumanoidRootPart")
                    if hrp then n = n + 1; list[n] = { model = v, hrp = hrp, isPlayer = Players:GetPlayerFromCharacter(v) ~= nil } end
                end
            else
                for _, p in ipairs(Players:GetPlayers()) do
                    local v = p.Character
                    local hrp = v and v:FindFirstChild("HumanoidRootPart")
                    if hrp then n = n + 1; list[n] = { model = v, hrp = hrp, isPlayer = true } end
                end
            end
            PlayerCache.list = list
        end
        return PlayerCache.list
    end
    local function byDist(a, b) return a[1] < b[1] end
    local function gather(cands, n, model, hrp, isPlayer, rootPos, char)
        if model == char or not model.Parent or not hrp.Parent then return n end
        local r = isPlayer and (FH.range / 1.5) or FH.range
        local d = (hrp.Position - rootPos).Magnitude
        if d <= r + hrp.Size.X / 2 then n = n + 1; cands[n] = { d, model } end
        return n
    end
    local function step()
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not resolve() then return end
        local CU, rootPos = FH.CombatUtil, root.Position
        local cands, n = {}, 0
        for _, e in ipairs(GetEnemyCache()) do
            n = gather(cands, n, e.model, e.hrp, false, rootPos, char)
        end
        if FH.players then
            for _, e in ipairs(GetPlayerCache()) do
                n = gather(cands, n, e.model, e.hrp, e.isPlayer, rootPos, char)
            end
        end
        if n == 0 then return end
        if n > FH.max then
            table.sort(cands, byDist)
            for i = n, FH.max + 1, -1 do cands[i] = nil end
            n = FH.max
        end
        local found, seen = {}, {}
        for i = 1, n do
            local model = cands[i][2]
            local c = hitOf[model]
            if c and c[1].Parent and c[2].Parent then
                local rig = c[1]
                if not seen[rig] and CU:IsVulnerable(rig) then
                    seen[rig] = true
                    found[#found + 1] = c
                end
            else
                for _, part in ipairs(model:GetChildren()) do
                    if part:IsA("BasePart") and VALID[part.Name] then
                        local rig = CU:GetRigOfHitPart(part)
                        if rig and not seen[rig] and CU:IsVulnerable(rig) then
                            seen[rig] = true
                            local pair = { rig, part }
                            hitOf[model] = pair
                            found[#found + 1] = pair
                            break
                        end
                    end
                end
            end
        end
        if #found > 0 then
            FH.RegAtk:FireServer(0)
            local first = table.remove(found, 1)
            FH.RegHit:FireServer(first[2], found)
        end
    end
    CombatTab:CreateToggle({
        Name     = "Burst",
