        local mouse = UserInputService:GetMouseLocation()
        local best, bestPx = nil, MouseRadius
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= lp and isEnemy(pl) then
                local hrp = getHRP(pl.Character)
                if hrp and (hrp.Position - lpHRP.Position).Magnitude <= maxRange then
                    local sp, on = cam:WorldToViewportPoint(hrp.Position)
                    if on and sp.Z > 0 then
                        local px = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                        if px < bestPx then bestPx, best = px, pl end
                    end
                end
            end
