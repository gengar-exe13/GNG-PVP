    local function isProtected(obj)
        local p = obj.Parent
        while p and p ~= workspace do
            if p.Parent == workspace and PROTECTED[p.Name] then return true end
            if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return true end
            p = p.Parent
        end
        return false
    end
