local fonts = { [0] = Enum.Font.Arial, [1] = Enum.Font.SourceSans, [2] = Enum.Font.GothamBold, [3] = Enum.Font.Code }
local function make(kind)
    local inst, st
    if kind == "Text" then
        inst = Instance.new("TextLabel")
        inst.BackgroundTransparency = 1
        inst.TextStrokeTransparency = 1
        inst.TextXAlignment = Enum.TextXAlignment.Left
        inst.TextYAlignment = Enum.TextYAlignment.Top
        inst.Font = fonts[2]
        inst.TextSize = 18
        inst.Size = UDim2.fromOffset(0, 0)
        inst.AutomaticSize = Enum.AutomaticSize.XY
    else
        inst = Instance.new("Frame")
        inst.BorderSizePixel = 0
        inst.BackgroundTransparency = 1
    end
    inst.Visible = false
    inst.Parent = gui
    local stroke
    if kind ~= "Line" then
        stroke = Instance.new("UIStroke")
        stroke.Enabled = false
        stroke.Parent = inst
    end
    st = { Visible = false, Color = Color3.new(1, 1, 1), Transparency = 1, Thickness = 1, Filled = false, Position = Vector2.new(), Size = Vector2.new(), From = Vector2.new(), To = Vector2.new(), Text = "", Center = false, Outline = false, OutlineColor = Color3.new(), Font = 2, ZIndex = 1 }
    local function apply()
        if not inst.Parent then return end
        inst.Visible = st.Visible
        inst.ZIndex = st.ZIndex
        local a = 1 - st.Transparency
        if kind == "Square" then
            inst.Position = UDim2.fromOffset(st.Position.X, st.Position.Y)
            inst.Size = UDim2.fromOffset(st.Size.X, st.Size.Y)
            if st.Filled then
                inst.BackgroundColor3 = st.Color
                inst.BackgroundTransparency = a
                stroke.Enabled = false
            else
                inst.BackgroundTransparency = 1
                stroke.Enabled = true
                stroke.Color = st.Color
                stroke.Thickness = st.Thickness
                stroke.Transparency = a
                stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            end
        elseif kind == "Line" then
            local d = st.To - st.From
            local len = d.Magnitude
            inst.BackgroundColor3 = st.Color
            inst.BackgroundTransparency = a
            inst.AnchorPoint = Vector2.new(0.5, 0.5)
            inst.Size = UDim2.fromOffset(len, math.max(st.Thickness, 1))
            local mid = (st.From + st.To) / 2
            inst.Position = UDim2.fromOffset(mid.X, mid.Y)
            inst.Rotation = math.deg(math.atan2(d.Y, d.X))
        else
            inst.Text = st.Text
            inst.TextColor3 = st.Color
            inst.TextTransparency = a
            inst.TextSize = typeof(st.Size) == "number" and st.Size or 18
            inst.Font = fonts[st.Font] or fonts[2]
            stroke.Enabled = st.Outline
            stroke.Color = st.OutlineColor
            local w = inst.AbsoluteSize.X
            inst.Position = UDim2.fromOffset(st.Position.X - (st.Center and w / 2 or 0), st.Position.Y)
        end
    end
    return setmetatable({}, {
        __index = function(_, k)
            if k == "Remove" or k == "Destroy" then
                return function() inst:Destroy() end
            elseif k == "TextBounds" then
                return Vector2.new(inst.AbsoluteSize.X, inst.AbsoluteSize.Y)
            end
            return st[k]
        end,
        __newindex = function(_, k, v)
            st[k] = v
            if k == "Size" and kind == "Text" then st.Size = v end
            apply()
        end,
    })
end
