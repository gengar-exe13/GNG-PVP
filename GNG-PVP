		elseif not keepSelection then
			self.Value = options[1]
		end
		rebuild()
	end
	Dropdown.SetOptions = Dropdown.Refresh
	table.insert(window._connections, head.MouseButton1Click:Connect(function()
		listFrame.Visible = not listFrame.Visible
		arrowDown.Visible = not listFrame.Visible
		arrowUp.Visible = listFrame.Visible
	end))
	rebuild()
	opt.SetActive(multi and anySelected() or false)
	registerFlag(config.Flag, Dropdown, multi and selSet or selected)
	return Dropdown
