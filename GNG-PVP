local function dn(t) return UI.ShortNames[t] or t end
local function themeSnapshot()
	local snap = {}
	for _, k in ipairs(THEME_KEYS) do snap[k] = Theme[k] end
	return snap
end
local function sameColor(a, b)
	return math.abs(a.R - b.R) < 0.0025 and math.abs(a.G - b.G) < 0.0025 and math.abs(a.B - b.B) < 0.0025
end
local function remapColor(c, old, new)
	for _, k in ipairs(THEME_KEYS) do
		if old[k] and new[k] and sameColor(old[k], c) then return new[k] end
	end
	return nil
end
local function rethemeTree(root, old, new)
	local function fix(inst, prop)
		local ok, c = pcall(function() return inst[prop] end)
		if ok and typeof(c) == "Color3" then
			local nc = remapColor(c, old, new)
			if nc then pcall(function() inst[prop] = nc end) end
		end
	end
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("UIStroke") then
			fix(inst, "Color")
		elseif inst:IsA("GuiObject") then
			fix(inst, "BackgroundColor3")
			if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
				fix(inst, "TextColor3")
				if inst:IsA("TextBox") then fix(inst, "PlaceholderColor3") end
			elseif inst:IsA("ScrollingFrame") then
				fix(inst, "ScrollBarImageColor3")
			end
		end
	end
end
function UI:SetAccentColor(name)
	local key, p = name, Palettes[name]
	if p == nil and typeof(name) == "string" then
		for n, pal in pairs(Palettes) do
			if n:lower():gsub("%s", "") == name:lower():gsub("%s", "") then key, p = n, pal break end
		end
	end
	if not p then
		warn("Unknown theme: " .. tostring(name))
		return
	end
	local old = themeSnapshot()
	UI.CurrentPalette = key
	for k, v in pairs(p) do Theme[k] = v end
	local new = themeSnapshot()
	for _, w in ipairs(UI.Windows) do
		if w.ScreenGui and w.ScreenGui.Parent then pcall(rethemeTree, w.ScreenGui, old, new) end
		if w._activeGui and w._activeGui.Parent then pcall(rethemeTree, w._activeGui, old, new) end
	end
end
