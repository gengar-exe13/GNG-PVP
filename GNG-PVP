do
    local M = { gen = 0, tool = nil, state = nil, stateAt = 0, fbCombo = 1, fbAt = 0, players = true, mobs = true, void = false }
    local RANGE = 100
    local MAXVEC = Vector3.new(9e30, 9e30, 9e30)
    local FRUITS = {
        Pain    = { max = 4, short = 0.31, long = 1.1  },
        Control = { max = 4, short = 0.26, long = 0.85 },
        Kitsune = { max = 5, short = 0.31, long = 1.1  },
        TRex    = { max = 4, short = 0.31, plain = true, nocd = true,
                    long = function(t) local r = t:FindFirstChild("TransformedRigObject"); return ((r and r.Value ~= nil) and 1.5 or 0.75) + 0.1 end },
    }
    local function getFruit()
        local char = lp.Character
        if char then
            for _, t in ipairs(char:GetChildren()) do
                if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then return t end
            end
        end
        local bp = lp:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then return t end
            end
        end
        return nil
    end
    local function scanTapFn(tool, fn)
        local comboIdx, nextIdx, timerIdx, hasTool, stateTable
        for n = 1, 30 do
            local ok, v = pcall(debug.getupvalue, fn, n)
            if not ok then break end
            if v == tool then hasTool = true end
            if type(v) == "number" then
                if not comboIdx and v >= 1 and v <= 5 and v == math.floor(v) then
                    comboIdx = n
                elseif not nextIdx and v > 1 then
                    nextIdx = n
                end
            elseif type(v) == "thread" and not timerIdx then
                timerIdx = n
            elseif type(v) == "table" and not stateTable then
                local ok3, ability = pcall(function() return v.thisAbility end)
                if ok3 and type(ability) == "number" and type(v.lastUseTime) == "number" then stateTable = v end
            end
        end
        if stateTable then return { tbl = stateTable, fn = fn } end
        if hasTool and comboIdx and nextIdx and timerIdx then
            return { fn = fn, combo = comboIdx, next = nextIdx, timer = timerIdx }
        end
        return nil
    end
    local function getTapState(tool)
        local ok, conns = pcall(getconnections, tool.Activated)
        if not ok or type(conns) ~= "table" then return nil end
        for _, c in ipairs(conns) do
            local fn = c.Function
            if fn then
                local st = scanTapFn(tool, fn)
                if st then return st end
                for n = 1, 8 do
                    local ok2, v = pcall(debug.getupvalue, fn, n)
                    if not ok2 then break end
                    if type(v) == "function" then
                        st = scanTapFn(tool, v)
                        if st then return st end
                    end
                end
            end
        end
        return nil
    end
    local function runEffect(delay, fn)
        task.delay(delay, function()
            local ok, err = pcall(fn)
            if not ok then warn("[FruitM1] effect error:", err) end
        end)
    end
    local function playEffect(key, index)
        local char = lp.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end
        local container = ReplicatedStorage:FindFirstChild("EffectContainer")
        if key == "Control" then
            runEffect(0.05, function()
                local Effect = require(ReplicatedStorage:WaitForChild("Effect"))
                local cr   = container and container:FindFirstChild("ControlRework")
                local m1   = cr and cr:FindFirstChild("M1")
                local tmpl = m1 and m1:FindFirstChild("Dagger_Outside")
                Effect.new(tmpl):play({ Origin = hrp.Position, Player = lp, Combo = index or 1, Character = char, Root = hrp })
            end)
            return
        end
        if key == "TRex" then
            local rig  = M.tool and M.tool:FindFirstChild("TransformedRigObject")
            local path = "Dino." .. ((rig and rig.Value ~= nil) and "Transformed." or "") .. "TAP"
            runEffect(0.1, function()
                local Effect = require(ReplicatedStorage:WaitForChild("Effect"))
                Effect.new(Effect.getModule(path)):play({ Character = char, ID = index or 1, player = lp })
            end)
            return
        end
        if key == "Pain" then
            runEffect(0.08, function()
                local Effect = require(ReplicatedStorage:WaitForChild("Effect"))
                local pain = container and container:FindFirstChild("Pain")
                local name = char:FindFirstChild("PainTransformed") and "M1_Awakened" or "M1"
                local tmpl = pain and pain:FindFirstChild(name)
                Effect.new(tmpl):play({ origin = hrp.Position, player = lp, Combo = index or 1, Character = char, Root = hrp })
            end)
            return
        end
        local folder   = container and container:FindFirstChild(key)
        local template = folder and folder:FindFirstChild("M1Combo")
        if not template then return end
        local filter = { char }
        for _, childName in ipairs({ "_WorldOrigin", "Characters", "Enemies" }) do
            local child = workspace:FindFirstChild(childName)
            if child then table.insert(filter, child) end
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = filter
        local onGround = workspace:Raycast(hrp.Position, -(hum.HipHeight + hrp.Size.Y * 0.5 + 4) * Vector3.new(0, 1, 0), params) ~= nil
        local transformed = false
        local flag = M.tool and M.tool:FindFirstChild("IsTransformed")
        if flag then transformed = flag.Value end
        runEffect(0.1, function()
            local Effect = require(ReplicatedStorage:WaitForChild("Effect"))
            Effect.new(template):replicate({ player = lp, hrp = hrp, index = index or 1, playerOnGround = onGround, transformed = transformed })
        end)
    end
    local function nearestTarget(myHRP)
        local bestHRP, bestDist
        if M.players then
            for _, player in ipairs(Players:GetPlayers()) do
                local pc = player ~= lp and player.Character
                if pc then
                    local tHRP = pc:FindFirstChild("HumanoidRootPart")
                    local tHum = pc:FindFirstChild("Humanoid")
                    if tHRP and tHum and tHum.Health > 0 then
                        local dist = (tHRP.Position - myHRP.Position).Magnitude
                        if dist < RANGE and (not bestDist or dist < bestDist) then bestHRP, bestDist = tHRP, dist end
                    end
                end
            end
        end
        if M.mobs then
            local enemies = workspace:FindFirstChild("Enemies")
            if enemies then
                for _, npc in ipairs(enemies:GetChildren()) do
                    local tHRP = npc:FindFirstChild("HumanoidRootPart")
                    local tHum = npc:FindFirstChild("Humanoid")
                    if tHRP and tHum and tHum.Health > 0 then
                        local dist = (tHRP.Position - myHRP.Position).Magnitude
                        if dist < RANGE and (not bestDist or dist < bestDist) then bestHRP, bestDist = tHRP, dist end
                    end
                end
            end
        end
        return bestHRP
    end
    local function step()
        local fruit = getFruit()
        local char  = lp.Character
        local myHRP = char and char:FindFirstChild("HumanoidRootPart")
        local key   = fruit and (fruit.Name == "T-Rex-T-Rex" and "TRex" or fruit.Name:match("^([^%-]+)"))
        local cfg   = key and FRUITS[key]
        local remote = cfg and fruit:FindFirstChild("LeftClickRemote")
        if not (cfg and remote and myHRP) then return 0.1 end
        if M.tool ~= fruit or (not M.state and tick() - M.stateAt > 1) then
            M.tool, M.stateAt, M.state = fruit, tick(), getTapState(fruit)
        end
        local st = M.state
        local combo, nextT
        if st then
            if st.tbl then
                if type(st.tbl.thisAbility) == "number" then combo = st.tbl.thisAbility end
                if type(st.tbl.lastUseTime) == "number" then nextT = st.tbl.lastUseTime end
            else
                local ok1, c = pcall(debug.getupvalue, st.fn, st.combo)
                local ok2, n = pcall(debug.getupvalue, st.fn, st.next)
                if ok1 and type(c) == "number" then combo = c end
                if ok2 and type(n) == "number" then nextT = n end
            end
        end
        if not combo or not nextT then
            if tick() - M.fbAt > 1 then M.fbCombo = 1 end
            combo, nextT = M.fbCombo, 0
        end
        local stun, busy = char:FindFirstChild("Stun"), char:FindFirstChild("Busy")
        local blocked = (stun and stun.Value > 0) or (busy and busy.Value)
        local cd = char:GetAttribute("FruitTAPCooldown") or 0
        if not blocked and time() >= nextT then
            local maxCombo = cfg.max
            if st and combo > maxCombo then
                combo = maxCombo
                if st.tbl then st.tbl.thisAbility = combo else pcall(debug.setupvalue, st.fn, st.combo, combo) end
            end
            local target = nearestTarget(myHRP)
            if target then
                local flat = (target.Position - myHRP.Position) * Vector3.new(1, 0, 1)
                if flat.Magnitude < 0.01 then flat = myHRP.CFrame.LookVector * Vector3.new(1, 0, 1) end
                local dir = flat.Unit
                local fireDir = (M.void and combo >= maxCombo) and MAXVEC or dir
                _AZ.FruitM1Firing = true
                pcall(function() if cfg.plain then remote:FireServer(fireDir, combo) else remote:FireServer(fireDir, combo, true) end end)
                _AZ.FruitM1Firing = false
                local long = type(cfg.long) == "function" and cfg.long(fruit) or cfg.long
                local interval = (combo >= maxCombo and long or cfg.short) - (cfg.nocd and 0 or cd)
                if st then
                    local nextCombo = combo < maxCombo and combo + 1 or 1
                    local nextTime  = time() + interval
                    if st.tbl then
                        st.tbl.thisAbility = nextCombo
                        st.tbl.lastUseTime = nextTime
                        if st.tbl.prevTask then pcall(task.cancel, st.tbl.prevTask) end
                        st.tbl.prevTask = task.delay(1, function() st.tbl.thisAbility = 1 end)
                    else
                        pcall(debug.setupvalue, st.fn, st.combo, nextCombo)
                        pcall(debug.setupvalue, st.fn, st.next, nextTime)
                        local okT, timer = pcall(debug.getupvalue, st.fn, st.timer)
                        if okT and timer then pcall(task.cancel, timer) end
                        pcall(debug.setupvalue, st.fn, st.timer, task.delay(1, function()
                            pcall(debug.setupvalue, st.fn, st.combo, 1)
                        end))
                    end
                else
                    M.fbCombo = combo < maxCombo and combo + 1 or 1
                    M.fbAt = tick()
                end
                playEffect(key, combo)
                if st then return 0.05 end
                return math.max(interval, 0)
            end
        end
        return 0.1
    end
    local function setM1(on)
        M.gen = M.gen + 1
        if not on then return end
        local myGen = M.gen
        task.spawn(function()
            while M.gen == myGen do
                local ok, wait = pcall(step)
                task.wait(ok and wait or 0.1)
            end
        end)
    end
