        local cf, size = part.CFrame, part.Size
        return part.Position.Y + 0.5 * (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z)
    end
    local function isFloorLike(part)
        local s = part.Size
        if s.Magnitude > 400 then return true end
        local cf = part.CFrame
        local ay = { math.abs(cf.RightVector.Y), math.abs(cf.UpVector.Y), math.abs(cf.LookVector.Y) }
        local dims = { s.X, s.Y, s.Z }
        local k = 1
        if ay[2] > ay[k] then k = 2 end
        if ay[3] > ay[k] then k = 3 end
        if ay[k] < 0.6 then return false end
        local t = dims[k]
        local a, b = dims[k % 3 + 1], dims[(k + 1) % 3 + 1]
        return t <= 12 and a * b >= 600 and topY(part) <= (groundY or 0) + 40
    end
